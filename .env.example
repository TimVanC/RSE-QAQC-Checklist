# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string for the dedicated project (HTTP driver; include sslmode=require).
DATABASE_URL=

# Neon Managed Better Auth: base URL of the auth endpoint from the Neon console.
NEON_AUTH_BASE_URL=

# Secret used to sign/encrypt the auth session cookie (32+ random characters).
NEON_AUTH_COOKIE_SECRET=

# Housecall Pro API key. Read-only, server-side only. Never expose to the browser.
HCP_API_KEY=

# Housecall Pro webhook signing secret, used to verify HMAC-SHA256 signatures.
HCP_WEBHOOK_SECRET=

# Bearer secret Vercel Cron sends to /api/cron/* (set the same value in Vercel project env).
CRON_SECRET=

# IANA timezone used for pay periods, the call queue day, and displayed times.
APP_TIMEZONE=America/New_York

# Public base URL of the app (used for magic-link redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# First admin for `npm run db:seed` (idempotent). The same email must exist in Neon Auth.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
